<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>peaceofmine_operator</name>
  <version>0.1.0</version>
  <description>Safe browser operator interface and simulation payloads for PeaceOfMine.</description>
  <maintainer email="21311514+nilskiefer@users.noreply.github.com">Nils Kiefer</maintainer>
  <license>Apache-2.0</license>

  <depend>geometry_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>svea_core</exec_depend>
  <exec_depend>svea_examples</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>web_video_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
