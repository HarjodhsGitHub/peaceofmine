<?xml version="1.0"?>
<launch>
  <!-- Arm and probe servos on the ArbotiX, in the operator namespace, for the
       Setup panel. Requires safe_arm firmware v1. -->
  <arg name="name" default="self"/>
  <arg name="calibration_file" default="$(find-pkg-share peaceofmine_operator)/calibration.json"/>
  <arg name="arm_serial_port" default="auto"/>
  <arg name="arm_servo_id" default="1"/>
  <arg name="arm_minimum" default="-1"/>
  <arg name="arm_center" default="-1"/>
  <arg name="arm_maximum" default="-1"/>
  <arg name="arm_speed" default="116"/>
  <arg name="arm_sweep_endpoint_tolerance_deg" default="4.0"/>
  <arg name="arm_sweep_acceleration_deg_s2" default="34.332"/>
  <arg name="probe_servo_id" default="2"/>
  <arg name="probe_minimum" default="-1"/>
  <arg name="probe_center" default="-1"/>
  <arg name="probe_maximum" default="-1"/>

  <group>
    <push_ros_namespace namespace="$(var name)"/>
    <include file="$(find-pkg-share peaceofmine_operator)/launch/arm_servo.launch.xml">
      <arg name="serial_port" value="$(var arm_serial_port)"/>
      <arg name="servo_id" value="$(var arm_servo_id)"/>
      <arg name="probe_servo_id" value="$(var probe_servo_id)"/>
      <arg name="calibration_file" value="$(var calibration_file)"/>
      <arg name="probe_minimum" value="$(var probe_minimum)"/>
      <arg name="probe_center" value="$(var probe_center)"/>
      <arg name="probe_maximum" value="$(var probe_maximum)"/>
      <arg name="minimum" value="$(var arm_minimum)"/>
      <arg name="center" value="$(var arm_center)"/>
      <arg name="maximum" value="$(var arm_maximum)"/>
      <arg name="speed" value="$(var arm_speed)"/>
      <arg name="sweep_endpoint_tolerance_deg" value="$(var arm_sweep_endpoint_tolerance_deg)"/>
      <arg name="sweep_acceleration_deg_s2" value="$(var arm_sweep_acceleration_deg_s2)"/>
    </include>
  </group>
</launch>
