<?xml version="1.0"?>
<launch>
  <!-- Edit these defaults for this setup, then run:
       ros2 launch peaceofmine_operator operator.launch.xml
       Stop the previous launch before switching vehicle modes. -->

  <!-- Mode and namespace -->
  <arg name="name" default="self"/>
  <arg name="is_sim" default="false"/>
  <!-- Simulation excludes the real arm and Arduino sensor. -->
  <arg name="simulate_payload" default="$(var is_sim)"/>

  <!-- Vehicle and drive -->
  <arg name="lli_serial_device" default="/dev/serial/by-id/usb-SVEA_PX4_AUTOPILOT_0-if00"/>
  <arg name="lli_baud_rate" default="921600"/>
  <arg name="max_velocity" default="0.8"/>

  <!-- Localization: enable when the corresponding sensors are ready. -->
  <arg name="use_localization" default="false"/>
  <arg name="is_indoor" default="true"/>
  <arg name="use_lidar" default="false"/>
  <arg name="use_rtk" default="false"/>
  <arg name="odometry_topic" default="odometry/local"/>

  <!-- Initial pose and simulated fixture -->
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>
  <arg name="fixture_angle_offset_deg" default="0.0"/>

  <!-- Arm servo -->
  <arg name="use_arm_servo" default="true"/>
  <arg name="arm_serial_port" default="auto"/>
  <arg name="arm_servo_id" default="-1"/>
  <!-- Record mechanical limits in Settings before preset moves or sweeping. -->
  <arg name="arm_minimum" default="-1"/>
  <arg name="arm_center" default="-1"/>
  <arg name="arm_maximum" default="-1"/>
  <arg name="arm_speed" default="20"/>

  <!-- Arduino detector -->
  <arg name="use_sensor_serial" default="true"/>
  <arg name="sensor_serial_port" default="/dev/serial/by-id/usb-Arduino_Srl_Arduino_Uno_7543134333435170D1E2-if00"/>
  <arg name="sensor_baud_rate" default="115200"/>
  <arg name="sensor_baseline_adc" default="0.0"/>
  <arg name="sensor_full_response_adc" default="255.0"/>

  <!-- Controller connected to the vehicle's USB port -->
  <arg name="use_joy" default="false"/>

  <!-- Dashboard and HTTPS -->
  <arg name="host" default="0.0.0.0"/>
  <arg name="port" default="8080"/>
  <!-- HTTPS is required for browser controllers on a remote host. -->
  <arg name="tls_cert" default=""/>
  <arg name="tls_key" default=""/>

  <!-- Cameras: auto discovery uses /dev/v4l/by-id. -->
  <arg name="use_cameras" default="true"/>
  <arg name="use_front_camera" default="true"/>
  <arg name="use_auxiliary_camera" default="false"/>
  <arg name="front_camera_device" default="auto"/>
  <arg name="auxiliary_camera_device" default="auto"/>
  <arg name="camera_width" default="640"/>
  <arg name="camera_height" default="480"/>
  <arg name="front_camera_framerate" default="30.0"/>
  <arg name="auxiliary_camera_framerate" default="30.0"/>
  <arg name="front_camera_pixel_format" default="mjpeg2rgb"/>
  <arg name="auxiliary_camera_pixel_format" default="yuyv2rgb"/>
  <arg name="camera_stream_port" default="8081"/>

  <!-- Launch composition -->
  <include file="$(find-pkg-share peaceofmine_operator)/launch/operator_vehicle.launch.py">
    <arg name="name" value="$(var name)"/>
    <arg name="is_sim" value="$(var is_sim)"/>
    <arg name="initial_pose_x" value="$(var initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(var initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(var initial_pose_a)"/>
    <arg name="lli_serial_device" value="$(var lli_serial_device)"/>
    <arg name="lli_baud_rate" value="$(var lli_baud_rate)"/>
    <arg name="use_localization" value="$(var use_localization)"/>
    <arg name="is_indoor" value="$(var is_indoor)"/>
    <arg name="use_lidar" value="$(var use_lidar)"/>
    <arg name="use_rtk" value="$(var use_rtk)"/>
  </include>


  <group>
    <push_ros_namespace namespace="$(var name)"/>
    <node if="$(var use_joy)" pkg="joy" exec="joy_node" name="operator_joy" output="screen">
      <param name="device_id" value="0"/>
      <param name="deadzone" value="0.12"/>
      <param name="autorepeat_rate" value="20.0"/>
      <param name="coalesce_interval_ms" value="50"/>
    </node>
    <group unless="$(var is_sim)">
    <group unless="$(var simulate_payload)">
    <include if="$(var use_sensor_serial)" file="$(find-pkg-share peaceofmine_operator)/launch/sensor_serial.launch.xml">
      <arg name="serial_port" value="$(var sensor_serial_port)"/>
      <arg name="baud_rate" value="$(var sensor_baud_rate)"/>
      <arg name="baseline_adc" value="$(var sensor_baseline_adc)"/>
      <arg name="full_response_adc" value="$(var sensor_full_response_adc)"/>
    </include>
    <include if="$(var use_arm_servo)" file="$(find-pkg-share peaceofmine_operator)/launch/arm_servo.launch.xml">
      <arg name="serial_port" value="$(var arm_serial_port)"/>
      <arg name="servo_id" value="$(var arm_servo_id)"/>
      <arg name="minimum" value="$(var arm_minimum)"/>
      <arg name="center" value="$(var arm_center)"/>
      <arg name="maximum" value="$(var arm_maximum)"/>
      <arg name="speed" value="$(var arm_speed)"/>
    </include>
    </group>
    </group>
    <node pkg="svea_examples" exec="twist_consumer.py" name="operator_twist_consumer" output="screen">
      <param name="twist_top" value="cmd_vel"/>
      <param name="max_velocity" value="$(var max_velocity)"/>
      <param name="cmd_timeout" value="0.25"/>
    </node>
    <node if="$(var simulate_payload)" pkg="peaceofmine_operator" exec="simulated_payload.py" name="simulated_payload" output="screen">
      <param name="odometry_topic" value="$(var odometry_topic)"/>
      <param name="fixture_angle_offset_deg" value="$(var fixture_angle_offset_deg)"/>
    </node>
    <node pkg="peaceofmine_operator" exec="operator_gateway.py" name="operator_gateway" output="screen">
      <param name="safety_simulation" value="$(var is_sim)"/>
      <param name="host" value="$(var host)"/>
      <param name="port" value="$(var port)"/>
      <param name="tls_cert" value="$(var tls_cert)" type="str"/>
      <param name="tls_key" value="$(var tls_key)" type="str"/>
      <param name="cmd_vel_topic" value="cmd_vel"/>
      <param name="odometry_topic" value="$(var odometry_topic)"/>
      <param name="max_velocity_mps" value="$(var max_velocity)"/>
      <param name="camera_stream_base_url" value="http://127.0.0.1:$(var camera_stream_port)"/>
      <param name="front_camera_topic" value="/$(var name)/camera_front/image_raw"/>
      <param name="auxiliary_camera_topic" value="/$(var name)/camera_auxiliary/image_raw"/>
      <param name="front_camera_info_topic" value="/$(var name)/camera_front/camera_info"/>
      <param name="auxiliary_camera_info_topic" value="/$(var name)/camera_auxiliary/camera_info"/>
    </node>
    <group if="$(var use_cameras)">
    <node if="$(var use_front_camera)" pkg="peaceofmine_operator" exec="usb_camera_auto.py" name="usb_camera" namespace="camera_front" output="screen">
      <env name="POM_CAMERA_INDEX" value="0"/>
      <env name="POM_CAMERA_DEVICE" value="$(var front_camera_device)"/>
      <param name="video_device" value="$(var front_camera_device)"/>
      <param name="image_width" value="$(var camera_width)"/>
      <param name="image_height" value="$(var camera_height)"/>
      <param name="framerate" value="$(var front_camera_framerate)"/>
      <param name="pixel_format" value="$(var front_camera_pixel_format)"/>
      <param name="camera_name" value="camera_front"/>
      <param name="frame_id" value="$(var name)/camera_front_link"/>
    </node>
    <node if="$(var use_auxiliary_camera)" pkg="peaceofmine_operator" exec="usb_camera_auto.py" name="usb_camera" namespace="camera_auxiliary" output="screen">
      <env name="POM_CAMERA_INDEX" value="1"/>
      <env name="POM_CAMERA_DEVICE" value="$(var auxiliary_camera_device)"/>
      <param name="video_device" value="$(var auxiliary_camera_device)"/>
      <param name="image_width" value="$(var camera_width)"/>
      <param name="image_height" value="$(var camera_height)"/>
      <param name="framerate" value="$(var auxiliary_camera_framerate)"/>
      <param name="pixel_format" value="$(var auxiliary_camera_pixel_format)"/>
      <param name="camera_name" value="camera_auxiliary"/>
      <param name="frame_id" value="$(var name)/camera_auxiliary_link"/>
    </node>
    <node if="$(var use_cameras)" pkg="web_video_server" exec="web_video_server" name="camera_stream_server" output="screen">
      <param name="port" value="$(var camera_stream_port)"/>
    </node>
    </group>
  </group>
</launch>
