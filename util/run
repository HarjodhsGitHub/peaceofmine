#! /bin/sh
#
# Create and start (run) a container.
#
# The container will be privileged and share the host network.
#
# Author: Kaj Munhoz Arfvidsson

. "$(dirname "$0")/config.sh"

CMD="docker run"
ARGS="$@"

operator_dashboard_host_ip() {
    if is_darwin; then
        interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
        if [ -n "$interface" ]; then
            ipconfig getifaddr "$interface" 2>/dev/null || true
        fi
    else
        hostname -I 2>/dev/null | awk '{print $1}'
    fi
}

# Default docker arguments
if isempty ARGS; then
    ARGS="--name $CONTAINER_NAME"
fi

# A manually stopped container still reserves its name, even with --rm.
if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    CONTAINER_STATUS="$(docker container inspect --format '{{.State.Status}}' "$CONTAINER_NAME")"
    if [ "$CONTAINER_STATUS" = "running" ]; then
        echo "Error: container \"$CONTAINER_NAME\" is already running"
        exit 1
    fi
    docker container rm "$CONTAINER_NAME" >/dev/null
fi

# Other docker arguments
append ARGS \
    -it \
    -v "$SHARED_VOLUME" \
    -v "$REPOSITORY_PATH/firmware:$WORKSPACE/firmware" \
    -v "$REPOSITORY_PATH/tools:$WORKSPACE/tools" \
    -e "TERM=xterm-256color" \
    --rm

DASHBOARD_HOST_IP="$(operator_dashboard_host_ip)"
if [ -n "$DASHBOARD_HOST_IP" ]; then
    append ARGS -e "OPERATOR_DASHBOARD_HOST_IP=$DASHBOARD_HOST_IP"
fi

# Discover MagicDNS on the host; the container need not run Tailscale itself.
DASHBOARD_HOSTNAME="${OPERATOR_DASHBOARD_HOSTNAME:-}"
if [ -z "$DASHBOARD_HOSTNAME" ] && command -v tailscale >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    DASHBOARD_HOSTNAME="$(python3 -c '
import json, subprocess
try:
    result = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=2, check=True)
    print(json.loads(result.stdout).get("Self", {}).get("DNSName", "").rstrip("."))
except (OSError, ValueError, subprocess.SubprocessError):
    pass
')"
fi
if [ -n "$DASHBOARD_HOSTNAME" ]; then
    append ARGS -e "OPERATOR_DASHBOARD_HOSTNAME=$DASHBOARD_HOSTNAME"
fi

# Enable device access for non-dev / non-macOS hosts
if ! (istrue DEV || is_darwin); then
    append ARGS \
        -v "/dev:/dev" \
        --privileged \
        --network host
else
    # Browser operator dashboard (simulation and macOS development)
    # :8080 (PeaceOfMine operator dashboard)
    append ARGS \
        -p 8080:8080
fi

# Image to run
append ARGS \
    "$IMAGE_TAG"

# Debug command with DEBUG=1
call $CMD $ARGS
