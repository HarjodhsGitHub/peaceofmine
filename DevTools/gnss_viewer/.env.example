# Copy this file to .env and fill in your SWEPOS account details.
# Keep .env private: it is ignored by Git.
# These are the existing SVEA defaults for the SWEPOS service.
# They can be omitted unless your account uses different settings.
NTRIP_HOST=nrtk-swepos.lm.se
NTRIP_PORT=80
NTRIP_MOUNTPOINT=MSM_GNSS
NTRIP_USERNAME=your_username
NTRIP_PASSWORD=your_password